{
  "$id": "https://example.com/narrowedUnion.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "narrowed": {
      "properties": { "shared": { "type": "string" } },
      "required": ["shared"],
      "oneOf": [
        {
          "properties": { "a": { "type": "integer" } },
          "required": ["a"]
        },
        {
          "properties": { "b": { "type": "integer" } },
          "required": ["b"]
        }
      ]
    },
    "narrowedArray": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": { "x": { "type": "integer" } },
        "required": ["x"]
      },
      "oneOf": [
        {
          "items": {
            "properties": { "y": { "type": "string" } },
            "required": ["y"]
          }
        }
      ]
    },
    "narrowedMap": {
      "additionalProperties": {
        "type": "object",
        "properties": { "m": { "type": "string" } },
        "required": ["m"]
      },
      "oneOf": [
        {
          "additionalProperties": {
            "properties": { "n": { "type": "integer" } },
            "required": ["n"]
          }
        }
      ]
    }
  },
  "required": ["narrowed", "narrowedArray", "narrowedMap"]
}
